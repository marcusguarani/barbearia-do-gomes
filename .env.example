# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env (ele já está no .gitignore).

# UltraMsg (envio de WhatsApp) — https://ultramsg.com
ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=

# Chave que protege o endpoint /api/whatsapp (deve ser igual à usada em
# js/app.js na constante WHATSAPP_API_KEY)
API_SECRET=

# Credenciais do painel administrativo, em JSON: {"usuario":"senha"}
ADMIN_CREDENTIALS={"admin1":"troque-esta-senha"}
